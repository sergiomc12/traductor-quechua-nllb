<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/crema">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_cabecera"
        android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="28dp" android:paddingBottom="26dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_launcher"
            android:contentDescription="Inca" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginLeft="14dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="Traductor Quechua" android:textColor="#FFFFFF" android:textSize="22sp"
              android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="Runasimi · Ayacucho-Chanka" android:textColor="@color/oro_claro" android:textSize="13sp"
              android:layout_marginTop="2dp" />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="22dp">
        <TextView android:id="@+id/chipOrigen" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_chip"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="Español" />
        <ImageButton android:id="@+id/btnIntercambiar" android:layout_width="46dp" android:layout_height="46dp"
            android:layout_marginLeft="10dp" android:layout_marginRight="10dp" android:background="@drawable/bg_swap"
            android:src="@drawable/ic_intercambio" android:contentDescription="Invertir idiomas" />
        <TextView android:id="@+id/chipDestino" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_chip"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="Quechua" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_tarjeta"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginTop="-6dp"
        android:padding="16dp" android:elevation="3dp">
      <TextView android:id="@+id/etiquetaEntrada" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textColor="@color/chicha" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
      <EditText android:id="@+id/entrada" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:minLines="3" android:gravity="top" android:background="@null" android:textColor="@color/tinta"
          android:textColorHint="@color/tinta_suave" android:textSize="19sp" android:paddingTop="8dp"
          android:paddingBottom="8dp" android:inputType="textMultiLine|textCapSentences" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnMicrofono" android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/bg_circulo_oro" android:src="@drawable/ic_mic_oscuro"
            android:contentDescription="Hablar" />
        <ImageButton android:id="@+id/btnVozEntrada" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginLeft="10dp" android:background="@drawable/bg_circulo_suave"
            android:src="@drawable/ic_altavoz" android:contentDescription="Escuchar" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/btnBorrar" android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/bg_circulo_suave" android:src="@drawable/ic_borrar"
            android:contentDescription="Borrar" />
      </LinearLayout>
    </LinearLayout>

    <Button android:id="@+id/btnTraducir" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginTop="14dp"
        android:background="@drawable/bg_boton" android:text="Traducir" android:textColor="#FFFFFF"
        android:textSize="17sp" android:textStyle="bold" android:textAllCaps="false" android:stateListAnimator="@null" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_tarjeta_oro"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginTop="14dp"
        android:padding="16dp">
      <TextView android:id="@+id/etiquetaSalida" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textColor="@color/chicha_oscuro" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
      <TextView android:id="@+id/salida" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:minHeight="72dp" android:textColor="@color/tinta" android:textSize="20sp"
          android:textIsSelectable="true" android:paddingTop="8dp" android:paddingBottom="8dp"
          android:text="La traducción aparecerá aquí" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnVozSalida" android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/bg_circulo_oro" android:src="@drawable/ic_altavoz"
            android:contentDescription="Escuchar traducción" />
        <ImageButton android:id="@+id/btnCopiar" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginLeft="10dp" android:background="@drawable/bg_circulo_suave"
            android:src="@drawable/ic_copiar" android:contentDescription="Copiar" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Switch android:id="@+id/autoVoz" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Leer en voz alta  " android:textColor="@color/chicha_oscuro" android:textSize="13sp"
            android:checked="true" />
      </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/aviso" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="20dp" android:gravity="center" android:textColor="@color/tinta_suave"
        android:textSize="12sp" />
  </LinearLayout>
</ScrollView>
