[Unit]
Description=Traductor Quechua-Espanol (FastAPI + NLLB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quechua
Group=quechua
WorkingDirectory=/opt/quechua
Environment=MODELO_DIR=/opt/quechua/models/principal_s0/mejor
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HUB_OFFLINE=1
Environment=OMP_NUM_THREADS=3
ExecStart=/opt/quechua/.venv/bin/uvicorn src.servicio.api:app --host 127.0.0.1 --port 8090 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --limit-concurrency 16 --timeout-keep-alive 5
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0077
MemoryMax=4G

[Install]
WantedBy=multi-user.target
